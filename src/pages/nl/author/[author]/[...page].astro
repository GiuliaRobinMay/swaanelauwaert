---
import ArchiveLayout from "../../../../layouts/ArchiveLayout.astro";
import { allPosts, paginated } from "../../../../lib/posts";
import taxonomies from "../../../../data/taxonomies.json";
import { UI } from "../../../../lib/site";
export async function getStaticPaths() {
  const posts = await allPosts();
  return taxonomies.users.flatMap((u) => {
    const items = posts.filter((p) => p.data.author === u.name);
    if (!items.length) return [];
    return paginated(items, `/nl/author/${u.slug}/`).map((x) => ({ params: { author: u.slug, page: x.params.page }, props: { ...x.props, name: u.name } }));
  });
}
const { page, name } = Astro.props;
---
<ArchiveLayout lang="nl" page={page} path={page.url(page.current)} label={UI.nl.author} name={name} bodyClass="archive author" />
