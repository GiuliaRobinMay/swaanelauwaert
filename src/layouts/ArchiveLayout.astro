---
import Base from "./Base.astro";
import PostGrid from "../components/PostGrid.astro";
import Pagination from "../components/Pagination.astro";
import { pageTitle, type Lang } from "../lib/site";
import type { Page, Post } from "../lib/posts";
interface Props { lang: Lang; page: Page<Post>; path: string; label: string; name: string; bodyClass?: string }
const { lang, page, path, label, name, bodyClass = "archive" } = Astro.props;
---
<Base lang={lang} title={pageTitle(`${name}`, lang)} path={path} bodyClass={`${bodyClass} wp-theme-twentytwentyfive`}>
  <main id="wp--skip-link--target" class="wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained" style="margin-top:var(--wp--preset--spacing--60)">
    <h1 class="wp-block-query-title">{label}: <span>{name}</span></h1>
    <PostGrid posts={page.items} lang={lang} />
    <div style="height:20px" aria-hidden="true" class="wp-block-spacer"></div>
    <Pagination page={page} lang={lang} />
    <div style="height:80px" aria-hidden="true" class="wp-block-spacer"></div>
  </main>
</Base>
