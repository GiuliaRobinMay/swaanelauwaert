---
<ul class="wp-block-jetpack-sharing-buttons has-normal-icon-size jetpack-sharing-buttons__services-list is-layout-flex wp-block-jetpack-sharing-buttons-is-layout-flex" id="jetpack-sharing-serivces-list">
  {services.map((s) => (
    <li class="jetpack-sharing-button__list-item">
      <a href={s.href} target={s.key === "share" ? undefined : "_blank"} rel="nofollow noopener noreferrer" class={`jetpack-sharing-button__button style-icon share-${s.key}`} data-service={s.key} data-shared={`sharing-${s.key}-${postId}`} aria-labelledby={`sharing-${s.key}-${postId}`} data-share-title={s.key === "share" ? title : undefined}>
        <span id={`sharing-${s.key}-${postId}`} hidden>{s.a11y}</span>
        <Fragment set:html={ICONS[s.key]} />
        <span class="jetpack-sharing-button__service-label" aria-hidden="true">{s.label}</span>
      </a>
    </li>
  ))}
</ul>
<script>
  // "Delen": use the native share sheet when available, otherwise copy the link.
  document.querySelectorAll<HTMLAnchorElement>("a.share-share").forEach((a) => {
    a.addEventListener("click", async (ev) => {
      ev.preventDefault();
      const data = { title: a.dataset.shareTitle || document.title, url: a.href };
      if (navigator.share) { try { await navigator.share(data); } catch {} }
      else if (navigator.clipboard) { await navigator.clipboard.writeText(a.href); a.querySelector(".jetpack-sharing-button__service-label")!.textContent = "Link gekopieerd"; }
    });
  });
</script>
