// Static version of the Jetpack sharing buttons shown under every post.
// Same markup and classes as the original (the theme CSS styles them); the
// hrefs are plain share intents instead of WordPress' ?share= handler.
import { SITE_URL } from "../lib/site";
interface Props { url: string; title: string; image?: string; postId: number }
const { url, title, image, postId } = Astro.props;
const full = SITE_URL + url;
const e = encodeURIComponent;
const services = [
  { key: "bluesky", label: "Bluesky", a11y: "Delen op Bluesky (Wordt in een nieuw venster geopend)", href: `https://bsky.app/intent/compose?text=${e(title + " " + full)}` },
  { key: "facebook", label: "Facebook", a11y: "Delen op Facebook (Wordt in een nieuw venster geopend)", href: `https://www.facebook.com/sharer/sharer.php?u=${e(full)}` },
  { key: "linkedin", label: "LinkedIn", a11y: "Delen op LinkedIn (Wordt in een nieuw venster geopend)", href: `https://www.linkedin.com/shareArticle?mini=true&url=${e(full)}&title=${e(title)}` },
  { key: "mastodon", label: "Mastodon", a11y: "Delen op Mastodon (Wordt in een nieuw venster geopend)", href: `https://mastodonshare.com/?text=${e(title)}&url=${e(full)}` },
  { key: "whatsapp", label: "WhatsApp", a11y: "Delen op WhatsApp (Wordt in een nieuw venster geopend)", href: `https://api.whatsapp.com/send?text=${e(title + " " + full)}` },
  { key: "pinterest", label: "Pinterest", a11y: "Delen op Pinterest (Wordt in een nieuw venster geopend)", href: `https://pinterest.com/pin/create/button/?url=${e(full)}${image ? "&media=" + e(SITE_URL + image) : ""}&description=${e(title)}` },
  { key: "x", label: "X", a11y: "Delen op X (Wordt in een nieuw venster geopend)", href: `https://x.com/intent/post?text=${e(title)}&url=${e(full)}` },
  { key: "share", label: "Delen", a11y: "Delen", href: full },
];
