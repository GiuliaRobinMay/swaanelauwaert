---
// Read-only rendering of the comments that existed on the original site
// (src/data/comments.json, produced by the migration from the REST dump).
// The static site cannot accept new comments, so the WordPress form is not
// reproduced; see docs/site-audit.md for the follow-up options.
import { formatDate, isoLocal, type Lang } from "../lib/site";
import fs from "node:fs";
interface Props { postId: number; lang: Lang; title: string }
const { postId, lang, title } = Astro.props;
const t = { nl: { one: (n: string) => `Één reactie op “${n}”`, many: (c: number, n: string) => `${c} reacties op “${n}”`, reply: "Antwoord" }, en: { one: (n: string) => `One response to “${n}”`, many: (c: number, n: string) => `${c} responses to “${n}”`, reply: "Reply" }, fr: { one: (n: string) => `Une réponse à “${n}”`, many: (c: number, n: string) => `${c} réponses à “${n}”`, reply: "Répondre" } }[lang];
interface C { id: number; post: number; parent: number; author_name: string; date: string; content: string; avatar?: string }
let all: C[] = [];
try { all = JSON.parse(fs.readFileSync(new URL("../data/comments.json", import.meta.url), "utf8")); } catch {}
const mine = all.filter((c) => c.post === postId).sort((a, b) => a.date.localeCompare(b.date));
const children = (id: number) => mine.filter((c) => c.parent === id);
const roots = children(0);
const avatar = (c: C) => c.avatar || "https://secure.gravatar.com/avatar/?s=50&d=mm&r=g";
---
{mine.length > 0 && (
  <>
    <h3 id="comments" class="wp-block-comments-title has-large-font-size">{mine.length === 1 ? t.one(title) : t.many(mine.length, title)}</h3>
    <ol class="wp-block-comment-template">
      {roots.map((c, i) => { const render = (c: C, depth: number, idx: number) => (
        <li id={`comment-${c.id}`} class={`comment ${idx % 2 ? "odd alt" : "even"} ${depth === 1 ? (idx % 2 ? "thread-odd thread-alt" : "thread-even") : ""} depth-${depth}`}>
          <div class="wp-block-group is-layout-flow wp-block-group-is-layout-flow" style="margin-top:0;margin-bottom:var(--wp--preset--spacing--50)">
            <div class="wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-40af6500 wp-block-group-is-layout-flex">
              <div class="wp-block-avatar"><img alt={`${c.author_name} avatar`} src={avatar(c)} class="avatar avatar-50 photo avatar-default wp-block-avatar__image" height="50" width="50" decoding="async" loading="lazy" /></div>
              <div class="wp-block-group is-layout-flow wp-block-group-is-layout-flow">
                <div class="wp-block-comment-date"><time datetime={isoLocal(new Date(c.date))}><a href={`#comment-${c.id}`}>{formatDate(new Date(c.date), lang)}</a></time></div>
                <div class="wp-block-comment-author-name">{c.author_name}</div>
                <div class="wp-block-comment-content" set:html={c.content} />
              </div>
            </div>
          </div>
          {children(c.id).length > 0 && <ol class="children">{children(c.id).map((cc, j) => render(cc, depth + 1, j))}</ol>}
        </li>
      ); return render(c, 1, i); })}
    </ol>
  </>
)}
