---
// Intro block of The Journal (from the theme's "home" template).
import { UI, SUBSTACK_URL, type Lang } from "../lib/site";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];
---
<div style="height:40px" aria-hidden="true" class="wp-block-spacer"></div>
{lang !== "fr" && <h1 class="wp-block-heading has-text-align-center"></h1>}
<div class="wp-block-buttons is-content-justification-center is-layout-flex wp-container-core-buttons-is-layout-35f06ea7 wp-block-buttons-is-layout-flex">
  <div class="wp-block-button is-style-fill"><a class="wp-block-button__link wp-element-button" href={SUBSTACK_URL} target="_blank" rel="noreferrer noopener">SUBSTACK</a></div>
</div>
<blockquote class="wp-block-quote is-layout-flow wp-block-quote-is-layout-flow">
  {lang !== "fr" && <h1 class="wp-block-heading has-text-align-center">The Journal</h1>}
  <p class="wp-block-paragraph">{t.journalIntro}</p>
  <p class="wp-block-paragraph">{t.follow} <a href={SUBSTACK_URL}>{SUBSTACK_URL}</a></p>
</blockquote>
<div style="height:20px" aria-hidden="true" class="wp-block-spacer"></div>
