---
import { UI, type Lang } from "../lib/site";
import { pageNumbers, type Page } from "../lib/posts";
interface Props { page: Page<unknown>; lang: Lang }
const { page, lang } = Astro.props;
const t = UI[lang];
---
{page.total > 1 && (
  <nav class="wp-block-query-pagination is-content-justification-center is-layout-flex wp-container-core-query-pagination-is-layout-b29d4327 wp-block-query-pagination-is-layout-flex" aria-label={t.paginationAria}>
    {page.prev && <a href={page.prev} class="wp-block-query-pagination-previous"><span class="wp-block-query-pagination-previous-arrow is-arrow-arrow" aria-hidden="true">←</span>{t.prevPage}</a>}
    <div class="wp-block-query-pagination-numbers">
      {pageNumbers(page.current, page.total).map((n, i) => <>{i > 0 && " "}{n === "dots" ? <span class="page-numbers dots">&hellip;</span> : n === page.current ? <span aria-current="page" class="page-numbers current">{n}</span> : <a class="page-numbers" href={page.url(n)}>{n}</a>}</>)}
    </div>
    {page.next && <a href={page.next} class="wp-block-query-pagination-next">{t.nextPage}<span class="wp-block-query-pagination-next-arrow is-arrow-arrow" aria-hidden="true">→</span></a>}
  </nav>
)}
