# Optional: endpoint that receives the contact form as JSON {name, email, message, page, _subject}.
# Works with Formspree (https://formspree.io/f/xxxx), Web3Forms, Basin, or your own function.
# Leave unset to fall back to opening the visitor's mail client.
PUBLIC_CONTACT_FORM_ENDPOINT=
PUBLIC_CONTACT_EMAIL=info@swaanelauwaert.com
