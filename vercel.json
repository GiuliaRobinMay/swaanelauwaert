{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/en/werk-met-mij",
      "destination": "/en/work-with-me/",
      "permanent": true
    },
    {
      "source": "/nl/maria-magdalena-retreat-zuid-frankrijk-2027",
      "destination": "/nl/maria-magdalena-retreat-zuid-frankrijk-2026/",
      "permanent": true
    },
    {
      "source": "/en/the-eros-sanctuary-2",
      "destination": "/en/body-untamed/",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/nl/feed",
      "destination": "/nl/feed.xml",
      "permanent": true
    },
    {
      "source": "/guide-sainte-baume",
      "destination": "/en/guide-sainte-baume/",
      "permanent": true
    },
    {
      "source": "/sainte-baume-guide",
